# TinyFish API Key (Required for Search & Fetch)
# Get one from: https://agent.tinyfish.ai/api-keys
TINYFISH_API_KEY=your_tinyfish_api_key_here

# Google Gemini API Key (Required for AI understanding, triage, and extraction)
# Get one from: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# Fast Gemini Flash model name (default: gemini-2.5-flash)
GEMINI_MODEL=gemini-2.5-flash
